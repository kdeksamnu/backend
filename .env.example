# Application Environment (development, testing, production)
FLASK_CONFIG=development

# Security Secrets (replace with secure random values in your local .env)
JWT_SECRET=your_super_secret_jwt_key_here
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_LIFETIME_SECONDS=900

# Database Connection URL (optional for development; falls back to sqlite:///dev.db)
DATABASE_URL=sqlite:///dev.db

# PostgreSQL Configuration (required for Docker Compose stack)
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=ml_pass
POSTGRES_DB=ml_backend_db
